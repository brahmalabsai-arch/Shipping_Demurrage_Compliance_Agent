  "narrative": {
    "northStar": "The Harbour Brochure That Works",
    "overview": "The desk borrows the calm of the Muselogist logistics site (pale-blue ground, ink type, sky-blue fields, square shapes with a hard offset block) and turns it into a working tool. A demo audience should see what is waiting on a person and what the agents saved before reading any table. Then they should be able to follow one shipment from papers checked to filed. The pages talk like an operator, not like the code.",
    "keyCharacteristics": [
      "Pale-blue ground with white panels and ink hairlines; dark mode mirrors every role.",
      "Young Serif for page titles, section titles and big figures; Outfit for everything else.",
      "Square corners everywhere except the status chips, which are pills.",
      "One signature move, the offset block, used only on what needs a person and on primary actions.",
      "One product move: the shipment lifecycle drawn as a route line."
    ],
    "rules": [
      {
        "name": "The Word-With-Colour Rule",
        "body": "Status is never shown by colour alone. Every chip, alert and route stop carries its word.",
        "section": "colors"
      },
      {
        "name": "The Coral-Is-For-Blockers Rule",
        "body": "Stop Coral appears only where something blocks clearance or a filing was rejected.",
        "section": "colors"
      },
      {
        "name": "The Lining Numerals Rule",
        "body": "Every serif number sets font-variant-numeric: lining-nums (plus tabular-nums in columns).",
        "section": "typography"
      },
      {
        "name": "The One Block Rule",
        "body": "At most one or two offset blocks per viewport. If everything is elevated, nothing is waiting.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do write labels and messages in operator words, and put internal ids in an expander.",
      "Do put what needs a person in a focus panel at the top of the page, before tables.",
      "Do add every new colour as a token in both LIGHT and DARK in dashboards/theme.py.",
      "Do set serif numbers with lining figures.",
      "Do show tables through theme.table so they follow the theme."
    ],
    "donts": [
      "Don't use st.dataframe on a page.",
      "Don't signal status by colour alone.",
      "Don't round corners on panels, inputs or buttons.",
      "Don't add blur shadows or gradients.",
      "Don't use em dashes or Python class names in visible copy.",
      "Don't put more than two offset blocks in one viewport."
    ]
  }
}
