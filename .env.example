# Copy to `.env` and fill in values. `.env` is git-ignored; this file holds keys only.
# Loaded by config/settings.py (pydantic-settings). Empty values fall back to Settings defaults.

# --- PostgreSQL (local native install; create role + DBs with scripts/setup_local_db.py) ---
# POSTGRES_TEST_DB is the disposable database pytest rebuilds on every run.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TEST_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- ChromaDB (embedded, in-process) — directory for its persistent data ---
CHROMA_PATH=

# --- Compliance RAG (Phase 9). Defaults = PolicyMind: BAAI/bge-base-en-v1.5 embeddings,
#     cross-encoder/ms-marco-MiniLM-L-6-v2 reranker, 20 candidates, RRF k=60, and the
#     reranker score below which a rule is "not found" ---
EMBEDDING_MODEL=
RERANKER_MODEL=
RAG_CANDIDATES=
RAG_RRF_K=
RAG_MIN_RERANK_SCORE=
# true (default): compliance_rulebook_mcp loads the models at startup (required on Windows)
RAG_PRELOAD_MODELS=

# --- Gmail OAuth (Phase 6) — files live under the git-ignored secrets/ directory ---
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
REVIEWER_EMAIL=

# --- Outgoing email: EMAIL_BACKEND=outbox (default: .eml files in OUTBOX_PATH) or gmail ---
EMAIL_BACKEND=
OUTBOX_PATH=

# --- Regulatory Watch scheduler (Phase 6) ---
WATCH_SCAN_INTERVAL_MINUTES=

# --- LLMs: LLM_PROVIDER=groq (default) or openai. Empty key for the chosen provider =
#     agents use deterministic fallbacks. Defaults: groq openai/gpt-oss-120b (reasoning) +
#     openai/gpt-oss-20b (summaries); openai gpt-5.5 + gpt-5.4-mini. ---
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_REASONING_MODEL=
GROQ_SUMMARY_MODEL=
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=
OPENAI_SUMMARY_MODEL=

# --- Logging ---
LOG_LEVEL=
